#!/usr/bin/env zsh

trap 'tput cnorm; exit' INT TERM
tput civis

range=$((RANDOM % 10 + 5))

frames=(
    "      ({)          "
    "       ()          "
    "        |          "
    "       ()          "
    "      ({)          "
    "      ({})         "
    "       (})         "
    "       ()          "
    "        |          "
    "       ()          "
    "      ({)          "
    "      ({})         "
)

timing=(0.01 0.01 0.02 0.01 0.01 0.02 0.01 0.01 0.02 0.01 0.01 0.02)

for (( i=1; i<=range; i++ )); do
    for (( j=1; j<=${#frames[@]}; j++ )); do

        printf "\r%s" "${frames[j]}"

        delay=$(( ${timing[j]} * i ))

        sleep $delay
    done
done

printf "\r                   "

if (( RANDOM % 2 )); then
    printf "\r      (^^)\n"
else
    printf "\r      (xx)\n"
fi

tput cnorm
