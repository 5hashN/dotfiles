set default-bg                  "#101010"
set default-fg                  "#EFA6A2"

set statusbar-fg                "#A3B8EF"
set statusbar-bg                "#80C990"

set inputbar-bg                 "#101010"
set inputbar-fg                 "#808080"

set notification-bg             "#101010"
set notification-fg             "#808080"

set notification-error-bg       "#101010"
set notification-error-fg       "#454545"

set notification-warning-bg     "#101010"
set notification-warning-fg     "#454545"

set highlight-color             "#C8C874"
set highlight-active-color      "#74C3E4"

set completion-bg               "#EFA6A2"
set completion-fg               "#74C3E4"

set completion-highlight-fg     "#808080"
set completion-highlight-bg     "#74C3E4"

set recolor-lightcolor          "#101010"
set recolor-darkcolor           "#74C3E4"

set recolor                     "false"
set recolor-keephue             "true"

set render-loading "false"

unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
map t recolor


